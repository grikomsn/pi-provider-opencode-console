{
  "name": "pi-provider-opencode-console",
  "version": "1.0.3",
  "description": "Pi providers for OpenCode Console and Go: device-auth login + service keys, live model discovery",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-provider",
    "opencode-console",
    "opencode-go",
    "pi-extension",
    "pi-package",
    "service-keys"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grikomsn/pi-provider-opencode-console.git"
  },
  "bugs": {
    "url": "https://github.com/grikomsn/pi-provider-opencode-console/issues"
  },
  "homepage": "https://github.com/grikomsn/pi-provider-opencode-console#readme",
  "files": [
    "src",
    "assets/cover.jpg",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "package": "npm pack --dry-run",
    "changeset": "changeset",
    "version": "changeset version"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "protobufjs@7.6.5": true
  }
}
